      "required": true,
      "minValue": 0,
      "maxValue": 128,
      "type": "slider",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "60"
    },
    {
      "name": "dfs.datanode.max.transfer.threads",
      "label": "Datanode进行传输数据的最大线程数",

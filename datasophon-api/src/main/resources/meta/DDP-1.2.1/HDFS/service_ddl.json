      "required": true,
      "separator": ",",
      "type": "multiple",
      "value": [
        "/data/hdfs/name"
      ],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": ""
    },
    {
      "name": "dfs.blocksize",
      "label": "Block大小",

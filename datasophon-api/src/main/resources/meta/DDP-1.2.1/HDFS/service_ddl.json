{
  "name": "HDFS",
  "label": "HDFS",
  "description": "分布式大数据存储",
  "version": "3.2.4",
  "sortNum": 1,
  "dependencies": [
    "ZOOKEEPER"
  ],
  "packageName": "hadoop-3.2.4.tar.gz",
  "decompressPackageName": "hadoop-3.2.4",
  "roles": [
    {
      "name": "JournalNode",
      "label": "JournalNode",
      "roleType": "master",
      "runAs": {
        "user": "hadoop",
        "group": "hadoop"
      },
      "cardinality": "1+",
      "sortNum": 1,
      "logFile": "${hadoopLogDir}/hadoop-hadoop-journalnode-${host}.log",
      "jmxPort": 27003,
      "startRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "start",
          "journalnode"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "control_hadoop.sh",
        "args": [
          "stop",
          "journalnode"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "status",
          "journalnode"
        ]
      }
    },
    {
      "name": "NameNode",
      "label": "NameNode",
      "roleType": "master",
      "runAs": {
        "user": "hadoop",
        "group": "hadoop"
      },
      "cardinality": "1+",
      "sortNum": 2,
      "logFile": "${hadoopLogDir}/hadoop-hadoop-namenode-${host}.log",
      "jmxPort": "27001",
      "startRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "start",
          "namenode"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "control_hadoop.sh",
        "args": [
          "stop",
          "namenode"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "status",
          "namenode"
        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "restart",
          "namenode"
        ]
      },
      "externalLink": {
        "name": "NameNode Ui",
        "label": "NameNode Ui",
        "url": "http://${host}:9870"
      }
    },
    {
      "name": "DataNode",
      "label": "DataNode",
      "roleType": "worker",
      "runAs": {
        "user": "hadoop",
        "group": "hadoop"
      },
      "cardinality": "1+",
      "sortNum": 5,
      "logFile": "${hadoopLogDir}/hadoop-hadoop-datanode-${host}.log",
      "jmxPort": "27002",
      "startRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "start",
          "datanode"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "control_hadoop.sh",
        "args": [
          "stop",
          "datanode"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "status",
          "datanode"
        ]
      }
    },
    {
      "name": "ZKFC",
      "label": "ZKFC",
      "roleType": "master",
      "runAs": {
        "user": "hadoop",
        "group": "hadoop"
      },
      "cardinality": "1+",
      "sortNum": 3,
      "logFile": "${hadoopLogDir}/hadoop-hadoop-zkfc-${host}.log",
      "jmxPort": 27004,
      "startRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "start",
          "zkfc"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "control_hadoop.sh",
        "args": [
          "stop",
          "zkfc"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "status",
          "zkfc"
        ]
      }
    },
    {
      "name": "HdfsClient",
      "label": "HdfsClient",
      "roleType": "client",
      "cardinality": "1+",
      "runAs": {
        "user": "hadoop",
        "group": "hadoop"
      }
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "core-site.xml",
        "configFormat": "xml",
        "outputDirectory": "etc/hadoop/",
        "includeParams": [
          "fs.defaultFS",
          "hadoop.tmp.dir",
          "io.file.buffer.size",
          "fs.trash.checkpoint.interval",
          "fs.trash.interval",
          "ha.zookeeper.quorum",
          "ha.zookeeper.session-timeout.ms",
          "hadoop.proxyuser.hadoop.hosts",
          "hadoop.proxyuser.hadoop.groups",
          "hadoop.proxyuser.hive.groups",
          "hadoop.proxyuser.hive.hosts",
          "hadoop.proxyuser.hue.hosts",
          "hadoop.proxyuser.hue.groups",
          "hadoop.proxyuser.datax.hosts",
          "hadoop.proxyuser.datax.groups",
          "hadoop.proxyuser.atlas.hosts",
          "hadoop.proxyuser.atlas.groups",
          "hadoop.proxyuser.ranger.hosts",
          "hadoop.proxyuser.ranger.groups",
          "hadoop.proxyuser.dlink.hosts",
          "hadoop.proxyuser.dlink.groups",
          "hadoop.proxyuser.spark.hosts",
          "hadoop.proxyuser.spark.groups",
          "hadoop.proxyuser.httpfs.groups",
          "hadoop.proxyuser.httpfs.hosts",
          "io.compression.codecs",
          "io.compression.codec.lzo.class",
          "custom.core.site.xml"
        ]
      },
      {
        "filename": "hadoop-env.sh",
        "configFormat": "custom",
        "outputDirectory": "etc/hadoop/",
        "templateName": "hadoop-env.ftl",
        "includeParams": [
          "hadoopLogDir",
          "hadoopHome",
          "datanodeHeapSize",
          "namenodeHeapSize",
          "custom.hadoop.env.sh"
        ]
      },
      {
        "filename": "hdfs-site.xml",
        "configFormat": "xml",
        "outputDirectory": "etc/hadoop/",
        "includeParams": [
          "dfs.nameservices",
          "dfs.ha.namenodes.${dfs.nameservices}",
          "dfs.namenode.rpc-address.${dfs.nameservices}.nn1",
          "dfs.namenode.rpc-address.${dfs.nameservices}.nn2",
          "dfs.namenode.http-address.${dfs.nameservices}.nn1",
          "dfs.namenode.http-address.${dfs.nameservices}.nn2",
          "dfs.namenode.shared.edits.dir",
          "dfs.journalnode.edits.dir",
          "dfs.journalnode.rpc-address",
          "dfs.journalnode.https-address",
          "dfs.ha.automatic-failover.enabled",
          "dfs.client.failover.proxy.provider.${dfs.nameservices}",
          "dfs.ha.fencing.methods",
          "dfs.ha.fencing.ssh.private-key-files",
          "dfs.namenode.name.dir",
          "dfs.datanode.data.dir",
          "dfs.replication",
          "dfs.webhdfs.enabled",
          "dfs.client.slow.io.warning.threshold.ms",
          "dfs.heartbeat.interval",
          "dfs.namenode.heartbeat.recheck-interval",
          "dfs.namenode.checkpoint.preiod",
          "dfs.namenode.checkpoint.txns",
          "dfs.blockreport.intervalMsec",
          "dfs.datanode.directoryscan.interval",
          "dfs.datanode.max.xcievers",
          "dfs.hosts",
          "dfs.balance.bandwidthPerSec",
          "dfs.blocksize",
          "dfs.namenode.handler.count",
          "dfs.datanode.max.transfer.threads",
          "dfs.datanode.directoryscan.threads",
          "dfs.datanode.handler.count",
          "dfs.datanode.slow.io.warning.threshold.ms",
          "dfs.safemode.threshold.pct",
          "dfs.namenode.replication.work.multiplier.per.iteration",
          "dfs.namenode.replication.max-streams",
          "dfs.namenode.replication.max-streams-hard-limit",
          "custom.hdfs.site.xml"
        ]
      },
      {
        "filename": "install.properties",
        "configFormat": "custom",
        "outputDirectory": "ranger-hdfs-plugin",
        "templateName": "ranger-hdfs.ftl",
        "includeParams": [
          "hadoopHome",
          "rangerAdminUrl"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "dfs.nameservices",
      "label": "集群名称",
      "description": "集群名称",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value": "ofcluster",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "ofcluster"
    },
    {
      "name": "fs.defaultFS",
      "label": "NameNode地址",
      "description": "NameNode地址",
      "required": true,
      "type": "input",
      "value": "hdfs://${dfs.nameservices}",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "hdfs://${dfs.nameservices}"
    },
    {
      "name": "hadoop.tmp.dir",
      "label": "Hadoop运行时文件存储目录",
      "description": "Hadoop运行时文件存储目录",
      "configType": "path",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "/data/hdfs/tmp"
    },
    {
      "name": "io.file.buffer.size",
      "label": "hdfs数据缓冲区大小",
      "description": "配置hdfs数据缓冲区大小",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "4096"
    },
    {
      "name": "fs.trash.checkpoint.interval",
      "label": "hdfs垃圾箱创建检查点的时间间隔",
      "description": "hdfs垃圾箱(.Trash)创建检查点的时间间隔，应小于或等于fs.trash.interval;默认为0",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "0"
    },
    {
      "name": "fs.trash.interval",
      "label": "hdfs trash时间间隔",
      "description": "会删除时间早于fs.trash.interval的检查点",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "1440"

{
  "name": "YARN",
  "label": "YARN",
  "description": "分布式资源调度与管理平台",
  "version": "3.2.4",
  "sortNum": 2,
  "dependencies":["HDFS"],
  "packageName": "hadoop-3.2.4.tar.gz",
  "decompressPackageName": "hadoop-3.2.4",
  "roles": [
    {
      "name": "ResourceManager",
      "label": "ResourceManager",
      "roleType": "master",
      "cardinality": "1+",
      "runAs": {
        "user": "hadoop",
        "group": "hadoop"
      },
      "sortNum": 1,
      "logFile": "logs/hadoop-hadoop-resourcemanager-${host}.log",
      "jmxPort": 9323,
      "startRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "start",
          "resourcemanager"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "control_hadoop.sh",
        "args": [
          "stop",
          "resourcemanager"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "status",
          "resourcemanager"
        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "restart",
          "resourcemanager"
        ]
      },
      "externalLink": {
        "name": "ResourceManager UI",
        "label": "ResourceManager UI",
        "url": "http://${host}:8088/ui2"
      }
    },
    {
      "name": "NodeManager",
      "label": "NodeManager",
      "roleType": "worker",
      "cardinality": "1+",
      "runAs": {
        "user": "hadoop",
        "group": "hadoop"
      },
      "sortNum": 3,
      "logFile": "logs/hadoop-hadoop-nodemanager-${host}.log",
      "jmxPort": 9324,
      "startRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "start",
          "nodemanager"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "control_hadoop.sh",
        "args": [
          "stop",
          "nodemanager"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "status","nodemanager"
        ]
      }
    },
    {
      "name": "HistoryServer",
      "label": "HistoryServer",
      "roleType": "master",
      "cardinality": "1+",
      "runAs": {
        "user": "hadoop",
        "group": "hadoop"
      },
      "sortNum": 2,
      "logFile": "logs/hadoop-hadoop-historyserver-${host}.log",
      "jmxPort": 9325,
      "startRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "start",
          "historyserver"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "control_hadoop.sh",
        "args": [
          "stop",
          "historyserver"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control_hadoop.sh",
        "args": [
          "status","historyserver"
        ]
      }
    },{
      "name": "YarnClient",
      "label": "YarnClient",
      "roleType": "client",
      "cardinality": "1+",
      "runAs": {
        "user": "hadoop",
        "group": "hadoop"
      }
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "yarn-site.xml",
        "configFormat": "xml",
        "outputDirectory": "etc/hadoop/",
        "includeParams": [
          "yarn.nodemanager.aux-services",
          "yarn.resourcemanager.ha.enabled",
          "yarn.resourcemanager.cluster-id",
          "yarn.resourcemanager.ha.rm-ids",
          "yarn.resourcemanager.hostname.rm1",
          "yarn.resourcemanager.hostname.rm2",
          "yarn.resourcemanager.webapp.address.rm1",
          "yarn.resourcemanager.webapp.address.rm2",
          "yarn.resourcemanager.webapp.https.address.rm1",
          "yarn.resourcemanager.webapp.https.address.rm2",
          "yarn.resourcemanager.scheduler.address.rm1",
          "yarn.resourcemanager.scheduler.address.rm2",
          "yarn.resourcemanager.resource-tracker.address.rm1",
          "yarn.resourcemanager.resource-tracker.address.rm2",
          "yarn.resourcemanager.admin.address.rm1",
          "yarn.resourcemanager.admin.address.rm2",
          "yarn.resourcemanager.zk-address",
          "yarn.nm.liveness-monitor.expiry-interval-ms",
          "yarn.scheduler.fair.user-as-default-queue",
          "yarn.nodemanager.pmem-check-enabled",
          "yarn.resourcemanager.ha.automatic-failover.enabled",
          "yarn.nodemanager.resource.memory-mb",
          "yarn.app.mapreduce.am.scheduler.connection.wait.interval-ms",
          "yarn.resourcemanager.recovery.enabled",
          "yarn.resourcemanager.store.class",
          "yarn.resourcemanager.connect.retry-interval.ms",
          "yarn.resourcemanager.zk.state-store.address",
          "yarn.nodemanager.vmem-pmem-ratio",
          "yarn.log-aggregation-enable",
          "yarn.log.server.url",
          "yarn.log-aggregation.retain-seconds",
          "yarn.nodemanager.log-dirs",
          "yarn.nodemanager.delete.debug-delay-sec",
          "yarn.nodemanager.remote-app-log-dir",
          "yarn.nodemanager.remote-app-log-dir-suffix",
          "yarn.nodemanager.local-dirs",
          "yarn.app.mapreduce.am.staging-dir",
          "yarn.nodemanager.aux-services.mapreduce.shuffle.class",
          "yarn.resourcemanager.scheduler.class",
          "yarn.nodemanager.resource.cpu-vcores",
          "yarn.resourcemanager.am.max-attempts",
          "yarn.scheduler.maximum-allocation-mb",
          "yarn.scheduler.minimum-allocation-mb",
          "yarn.resourcemanager.ha.automatic-failover.embedded",
          "yarn.resourcemanager.nodemanagers.heartbeat-interval-ms",
          "yarn.scheduler.maximum-allocation-vcores",
          "yarn.scheduler.minimum-allocation-vcores",
          "yarn.nodemanager.log.retain-seconds",
          "yarn.nodemanager.vmem-check-enabled",
          "yarn.resourcemanager.max-completed-applications",
          "yarn.log-aggregation.retain-check-interval-seconds",
          "yarn.nodemanager.linux-container-executor.nonsecure-mode.local-user",
          "yarn.nodemanager.linux-container-executor.group",
          "yarn.nodemanager.container-executor.class",
          "yarn.nodemanager.linux-container-executor.resources-handler.class",
          "yarn.nodemanager.linux-container-executor.cgroups.hierarchy",
          "yarn.nodemanager.linux-container-executor.cgroups.mount",
          "yarn.nodemanager.linux-container-executor.cgroups.mount-path",
          "yarn.nodemanager.resource.percentage-physical-cpu-limit",
          "yarn.nodemanager.linux-container-executor.cgroups.strict-resource-usage",
          "yarn.nodemanager.resource.count-logical-processors-as-cores",
          "yarn.application.classpath",
          "yarn.nodemanager.env-whitelist",
          "custom.yarn.site.xml"
        ]
      },
      {
        "filename": "mapred-site.xml",
        "configFormat": "xml",
        "outputDirectory": "etc/hadoop/",
        "includeParams": [
          "mapreduce.framework.name",
          "mapreduce.cluster.local.dir",
          "mapreduce.cluster.temp.dir",
          "mapreduce.map.java.opts",
          "mapreduce.map.memory.mb",
          "mapreduce.reduce.java.opts",
          "mapreduce.reduce.memory.mb",
          "local.cache.size",
          "mapreduce.jobhistory.cleaner.interval-ms",
          "mapreduce.jobhistory.joblist.cache.size",
          "mapreduce.jobhistory.datestring.cache.size",
          "mapreduce.jobhistory.cleaner.enable",
          "mapreduce.jobhistory.max-age-ms",
          "yarn.app.mapreduce.am.env",
          "mapreduce.map.env",
          "mapreduce.reduce.env",
          "mapreduce.application.classpath",
          "custom.mapred.site.xml"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "yarn.nodemanager.aux-services",
      "label": "yarn服务机制",
      "description": "yarn服务机制",
      "required": true,
      "type": "input",
      "value": "mapreduce_shuffle",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "mapreduce_shuffle"
    },
    {
      "name": "yarn.resourcemanager.ha.enabled",
      "label": "是否启用resourcemanager ha",
      "description": "是否启用resourcemanager ha",
      "configType": "ha",
      "required": true,
      "type": "switch",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": true
    },
    {
      "name": "yarn.resourcemanager.cluster-id",
      "label": "resourcemanager高可用集群id",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"ofyarncluster",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "ofyarncluster"
    },
    {
      "name": "yarn.resourcemanager.ha.rm-ids",
      "label": "resourcemanager高可用节点",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "rm1,rm2"
    },
    {
      "name": "yarn.resourcemanager.hostname.rm1",
      "label": "rm1主机名",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${rm1}"
    },
    {
      "name": "yarn.resourcemanager.hostname.rm2",
      "label": "rm2主机名",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${rm2}"
    },
    {
      "name": "yarn.resourcemanager.webapp.address.rm1",
      "label": "rm1 web地址",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${rm1}:8088"
    },
    {
      "name": "yarn.resourcemanager.webapp.address.rm2",
      "label": "rm2 web地址",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${rm2}:8088"
    },
    {
      "name": "yarn.resourcemanager.webapp.https.address.rm1",
      "label": "rm1 web https地址",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${rm1}:8090"
    },
    {
      "name": "yarn.resourcemanager.webapp.https.address.rm2",
      "label": "rm2 web https地址",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${rm2}:8090"
    },
    {
      "name": "yarn.resourcemanager.scheduler.address.rm1",
      "label": "ResourceManager对ApplicationMaster暴露的访问地址rm1",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${rm1}:8030"
    },
    {
      "name": "yarn.resourcemanager.scheduler.address.rm2",
      "label": "ResourceManager对ApplicationMaster暴露的访问地址rm2",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${rm2}:8030"
    },
    {
      "name": "yarn.resourcemanager.resource-tracker.address.rm1",
      "label": "ResourceManager对NodeManager暴露的地址rm1",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${rm1}:8031"
    },
    {
      "name": "yarn.resourcemanager.resource-tracker.address.rm2",
      "label": "ResourceManager对NodeManager暴露的地址rm2",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${rm2}:8031"
    },
    {
      "name": "yarn.resourcemanager.admin.address.rm1",
      "label": "ResourceManager管理界面的地址rm1",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${rm1}:8033"
    },
    {
      "name": "yarn.resourcemanager.admin.address.rm2",
      "label": "ResourceManager管理界面的地址rm2",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${rm2}:8033"
    },
    {
      "name": "yarn.resourcemanager.zk-address",
      "label": "zk地址",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${zkUrls}"
    },
    {
      "name": "yarn.nm.liveness-monitor.expiry-interval-ms",
      "label": "等待节点管理器被认为已经死亡的时间",
      "description": "默认10分钟",
      "required": true,
      "type": "input",
      "value":"600000",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "600000"
    },
    {
      "name": "yarn.scheduler.fair.user-as-default-queue",
      "label": "是否使用用户名关联分配的默认队列名称",
      "description": "如果是false或者未设置，所有的作业都有一个共享的默认队列，叫做default",
      "required": true,
      "type": "input",
      "value":"true",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "true"
    },
    {
      "name": "yarn.nodemanager.pmem-check-enabled",
      "label": "是否将对容器强制实施物理内存限制",
      "description": "",
      "required": true,
      "type": "input",
      "value":"false",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "false"
    },
    {
      "name": "yarn.resourcemanager.ha.automatic-failover.enabled",
      "label": "是否启用自动故障转移",
      "description": "",
      "required": true,
      "type": "input",
      "value":"true",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "true"
    },
    {
      "name": "yarn.nodemanager.resource.memory-mb",
      "label": "nodemanager内存",
      "description": "可分配给容器的内存",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "65536"
    },
    {
      "name": "yarn.app.mapreduce.am.scheduler.connection.wait.interval-ms",
      "label": "schelduler失联等待连接时间",
      "description": "",
      "required": true,
      "type": "input",
      "value": "5000",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "5000"
    },
    {
      "name": "yarn.resourcemanager.recovery.enabled",
      "label": "启用自动恢复",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "switch",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": true
    },
    {
      "name": "yarn.resourcemanager.store.class",
      "label": "yarn状态信息存储类",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "org.apache.hadoop.yarn.server.resourcemanager.recovery.ZKRMStateStore"
    },
    {
      "name": "yarn.resourcemanager.connect.retry-interval.ms",
      "label": "rm失联后重连的时间间隔",
      "description": "",
      "required": true,
      "type": "input",
      "value": "2000",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "2000"
    },
    {
      "name": "yarn.resourcemanager.zk.state-store.address",
      "label": "ZKRMStateStore连接的zk地址",
      "description": "",
      "required": true,
      "type": "input",
      "value": "${zkUrls}",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${zkUrls}"
    },
    {
      "name": "yarn.nodemanager.vmem-pmem-ratio",
      "label": "虚拟内存与物理内存之间的比率",
      "description": "为容器设置内存限制时，虚拟内存与物理内存之间的比率。",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "2.1"
    },
    {
      "name": "yarn.log-aggregation-enable",
      "label": "是否开启yarn日志聚合",
      "description": "开启yarn日志聚合",
      "required": true,
      "type": "switch",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": true
    },
    {
      "name": "yarn.log.server.url",
      "label": "historyserver地址",
      "description": "",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "http://${historyserverHost}:19888/jobhistory/logs"
    },
    {
      "name": "yarn.log-aggregation.retain-seconds",
      "label": "日志保留时长",
      "description": "",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "2592000"
    },
    {
      "name": "yarn.nodemanager.log-dirs",
      "label": "NodeManager日志存储目录",
      "description": "NodeManager日志存储目录，可配置多个，按逗号分隔",
      "required": true,
      "configType": "path",
      "separator": ",",
      "type": "multiple",
      "value": [
        "/data/nm/userlogs"
      ],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": ""
    },
    {
      "name": "yarn.nodemanager.delete.debug-delay-sec",
      "label": "application执行结束后延迟该时间删除文件及日志",
      "description": "单位s",
      "required": true,
      "type": "input",
      "value":"600",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "600"
    },
    {
      "name": "yarn.nodemanager.remote-app-log-dir",
      "label": "日志保留位置",
      "description": "",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "hdfs://${dfs.nameservices}/user/yarn/yarn-logs/"
    },
    {
      "name": "yarn.nodemanager.remote-app-log-dir-suffix",
      "label": "日志保留位置suffix",
      "description": "hdfs上集合日志后的存放地址由 remote-app-log-dir/user/thisParam 构成",
      "required": true,
      "type": "input",
      "value":"",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "logs"
    },
    {
      "name": "yarn.nodemanager.local-dirs",
      "label": "NodeManager本地存储目录",
      "description": "NodeManager本地存储目录，可配置多个，按逗号分隔",
      "required": true,
      "configType": "path",
      "separator": ",",
      "type": "multiple",
      "value": [
        "/data/nm"
      ],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": ""
    },
    {
      "name": "yarn.app.mapreduce.am.staging-dir",
      "label": "MR作业在提交时所使用的临时目录",
      "description": "默认为/tmp/hadoop-yarn/staging",
      "required": true,
      "configType": "path",
      "separator": ",",
      "type": "multiple",
      "value": [
        "/data/nm/tmp/hadoop-yarn/staging"
      ],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": ""
    },
    {
      "name": "yarn.nodemanager.aux-services.mapreduce.shuffle.class",
      "label": "yarn状态信息存储类",
      "description": "",
      "configType": "ha",
      "required": true,
      "type": "input",
      "value":"org.apache.hadoop.mapred.ShuffleHandler",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "org.apache.hadoop.mapred.ShuffleHandler"
    },
    {
      "name": "yarn.resourcemanager.scheduler.class",
      "label": "资源调度器",
      "description": "选择资源调度器，容量调度器或公平调度器",
      "required": true,
      "type": "select",
      "value":"org.apache.hadoop.yarn.server.resourcemanager.scheduler.capacity.CapacityScheduler",
      "selectValue": [
        "org.apache.hadoop.yarn.server.resourcemanager.scheduler.capacity.CapacityScheduler",
        "org.apache.hadoop.yarn.server.resourcemanager.scheduler.fair.FairScheduler"
      ],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "org.apache.hadoop.yarn.server.resourcemanager.scheduler.fair.FairScheduler"
    },
    {
      "name": "yarn.nodemanager.resource.cpu-vcores",
      "label": "nodemanager虚拟核数",
      "description": "nodemanager虚拟核数",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "-1"
    },
    {
      "name": "yarn.resourcemanager.am.max-attempts",
      "label": "AM重试次数",
      "description": "",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "2"
    },
    {
      "name": "yarn.scheduler.maximum-allocation-mb",
      "label": "RM上每个容器请求的最大分配量（MB）",
      "description": "RM上每个容器请求的最大分配量（MB）",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "65536"
